1 VERSIONINFO
 FILEVERSION @REXGLUE_RUNTIME_RC_VERSION@
 PRODUCTVERSION @REXGLUE_RUNTIME_RC_VERSION@
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x2L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "@REXGLUE_RUNTIME_RC_COMPANY@"
            VALUE "FileDescription", "@REXGLUE_RUNTIME_RC_DESCRIPTION@"
            VALUE "FileVersion", "@REXGLUE_RUNTIME_RC_VERSION_STRING@"
            VALUE "InternalName", "rexruntime"
            VALUE "LegalCopyright", "@REXGLUE_RUNTIME_RC_COPYRIGHT@"
            VALUE "OriginalFilename", "rexruntime.dll"
            VALUE "ProductName", "@REXGLUE_RUNTIME_RC_PRODUCT_NAME@"
            VALUE "ProductVersion", "@REXGLUE_RUNTIME_RC_VERSION_STRING@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
