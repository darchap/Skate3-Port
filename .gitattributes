# Normalise line endings to LF in the repository regardless of host OS.
* text=auto eol=lf

# Windows scripts must keep CRLF so cmd.exe/PowerShell parse them reliably.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary files: never normalise.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.zip binary
*.7z binary
*.exe binary
*.dll binary
*.so binary
*.a binary
*.lib binary
*.spv binary
*.cab binary
*.obj binary
*.bin binary
*.xex binary
*.xexp binary
*.apk binary
*.jar binary
*.ttf binary
*.otf binary
*.wav binary
*.ogg binary
